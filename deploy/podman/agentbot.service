# systemd user unit for the AgentBot compose stack on a Podman host (architecture §7.2, requirements OPS-05).
# deploy/podman/deploy.sh installs it as ~/.config/systemd/user/agentbot.service, with its deploy directory as the
# working directory and environment file, and enables it, so the stack starts at boot with the version pinned in that
# directory's .env. It needs the user's Podman socket (`systemctl --user enable --now podman.socket`) and linger
# (`sudo loginctl enable-linger <user>`), or the user manager, and with it the stack, only runs while the user is
# logged in.
[Unit]
Description=AgentBot (podman compose stack)
Wants=network-online.target podman.socket
After=network-online.target podman.socket

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/agentbot
# The deploy directory's .env, so that settings such as PODMAN_COMPOSE_PROVIDER apply here as in deploy.sh.
EnvironmentFile=-%h/agentbot/.env
Environment=PODMAN_COMPOSE_WARNING_LOGS=false
ExecStart=/usr/bin/podman compose up -d
# `stop`, not `down`: down would also remove the stack network, which running worker containers are still attached to.
ExecStop=/usr/bin/podman compose stop
TimeoutStartSec=600

[Install]
WantedBy=default.target
